#!/bin/sh
# Rechaza el commit si el arbol actual no tiene el cierre `bun run verify` en verde.
# Se instala una vez por copia con: bun run ganchos:instalar
set -u

raiz=$(git rev-parse --show-toplevel 2>/dev/null) || exit 1
raiz=$(printf '%s' "$raiz" | tr '\\' '/')
cd "$raiz" || exit 1

if command -v bun >/dev/null 2>&1; then
    bun_bin="bun"
elif [ -x "$HOME/.bun/bin/bun" ]; then
    bun_bin="$HOME/.bun/bin/bun"
else
    echo "Commit bloqueado: no encuentro 'bun' en PATH." >&2
    exit 1
fi

exec "$bun_bin" run scripts/validacion.ts exigir --origen gancho-git
