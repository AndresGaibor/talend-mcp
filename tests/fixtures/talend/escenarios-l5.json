    {
      "nombre": "transformaciones: agregar por ciudad",
      "job": "MCP_L5_Agrega",
      "pendiente": "el tAggregateRow no propaga su schema (SCHEMA_AUTO_PROPAGATE=false): al poner sus columnas de salida, Talend las propaga hacia atras y el origen se queda con ellas en vez de las suyas, y el generador no encuentra la columna de entrada ('inputColumn is null')",
      "nodos": [
        {
          "type": "tAggregateRow",
          "nombre": "agrega",
          "schemaDespuesDeConectar": true,
          "esquemas": [
            {
              "conector": "FLOW",
              "nombre": "@uniqueName",
              "columnas": [
                {
                  "name": "ciudad",
                  "type": "id_String"
                },
                {
                  "name": "total_monto",
                  "type": "id_Double"
                },
                {
                  "name": "num_clientes",
                  "type": "id_Integer"
                }
              ]
            }
          ],
          "tablas": {
            "GROUPBYS": {
              "columns": [
                "OUTPUT_COLUMN",
                "INPUT_COLUMN"
              ],
              "rows": [
                {
                  "OUTPUT_COLUMN": "ciudad",
                  "INPUT_COLUMN": "row1.ciudad"
                }
              ]
            },
            "OPERATIONS": {
              "columns": [
                "OUTPUT_COLUMN",
                "FUNCTION",
                "INPUT_COLUMN",
                "IGNORE_NULL"
              ],
              "rows": [
                {
                  "OUTPUT_COLUMN": "total_monto",
                  "FUNCTION": "SUM",
                  "INPUT_COLUMN": "row1.monto",
                  "IGNORE_NULL": "true"
                },
                {
                  "OUTPUT_COLUMN": "num_clientes",
                  "FUNCTION": "COUNT",
                  "INPUT_COLUMN": "row1.id",
                  "IGNORE_NULL": "true"
                }
              ]
            }
          }
        },
        {
          "type": "tFileInputDelimited",
          "nombre": "lector",
          "schemaDespuesDeConectar": true,
          "parameters": {
            "FILENAME": {
              "value": "@TESTDATA@/l5_clientes.csv"
            },
            "FIELDSEPARATOR": {
              "value": ";"
            },
            "HEADER": {
              "value": "1"
            },
            "ENCODING": {
              "value": "UTF-8"
            }
          },
          "columnas": [
            {
              "name": "id",
              "type": "id_Integer"
            },
            {
              "name": "nombre",
              "type": "id_String"
            },
            {
              "name": "ciudad",
              "type": "id_String"
            },
            {
              "name": "monto",
              "type": "id_Double"
            }
          ]
        },
        {
          "type": "tLogRow",
          "nombre": "salida"
        }
      ],
      "conexiones": [
        {
          "origen": "lector",
          "destino": "agrega"
        },
        {
          "origen": "agrega",
          "destino": "salida"
        }
      ],
      "espera": {
        "contiene": [
          "Bogota|201.0|2",
          "Medellin|200.25|1",
          "Cali|300.0|1"
        ]
      }
