{
  "escenarios": [
    {
      "nombre": "humo: entrada fija a log",
      "job": "MCP_L5_Humo",
      "nodos": [
        {
          "type": "tFixedFlowInput",
          "nombre": "entrada",
          "columnas": [
            { "name": "id", "type": "id_Integer" },
            { "name": "ciudad", "type": "id_String" }
          ],
          "values": [["1", "Bogota"], ["2", "Medellin"]]
        },
        { "type": "tLogRow", "nombre": "salida" }
      ],
      "conexiones": [{ "origen": "entrada", "destino": "salida" }],
      "espera": {
        "lineas": ["1|Bogota", "2|Medellin"]
      }
    },
    {
      "nombre": "archivos: leer un CSV y volcarlo al log",
      "job": "MCP_L5_Leer",
      "nodos": [
        {
          "type": "tFileInputDelimited",
          "nombre": "lector",
          "parameters": {
            "FILENAME": { "value": "@TESTDATA@/l5_clientes.csv" },
            "FIELDSEPARATOR": { "value": ";" },
            "HEADER": { "value": "1" },
            "ENCODING": { "value": "UTF-8" }
          },
          "columnas": [
            { "name": "id", "type": "id_Integer" },
            { "name": "nombre", "type": "id_String" },
            { "name": "ciudad", "type": "id_String" },
            { "name": "monto", "type": "id_Double" }
          ]
        },
        { "type": "tLogRow", "nombre": "salida" }
      ],
      "conexiones": [{ "origen": "lector", "destino": "salida" }],
      "espera": {
        "lineas": [
          "1|Ana|Bogota|100.5",
          "2|Jose|Medellin|200.25",
          "3|Lucia|Cali|300.0",
          "1|Ana|Bogota|100.5"
        ]
      }
    },
    {
      "nombre": "archivos: leer un CSV y escribir otro",
      "job": "MCP_L5_Escribir",
      "nodos": [
        {
          "type": "tFileInputDelimited",
          "nombre": "lector",
          "parameters": {
            "FILENAME": { "value": "@TESTDATA@/l5_clientes.csv" },
            "FIELDSEPARATOR": { "value": ";" },
            "HEADER": { "value": "1" },
            "ENCODING": { "value": "UTF-8" }
          },
          "columnas": [
            { "name": "id", "type": "id_Integer" },
            { "name": "nombre", "type": "id_String" },
            { "name": "ciudad", "type": "id_String" },
            { "name": "monto", "type": "id_Double" }
          ]
        },
        {
          "type": "tFileOutputDelimited",
          "nombre": "escritor",
          "parameters": {
            "FILENAME": { "value": "@TESTDATA@/l5_salida.csv" },
            "FIELDSEPARATOR": { "value": ";" },
            "ENCODING": { "value": "UTF-8" },
            "CREATE_HEADER": { "value": "false" },
            "FILE_EXIST_EXCEPTION": { "value": "false" }
          }
        }
      ],
      "conexiones": [{ "origen": "lector", "destino": "escritor" }],
      "espera": {
        "fichero": {
          "ruta": "@TESTDATA@/l5_salida.csv",
          "lineas": 4,
          "contiene": ["1;Ana;Bogota;100.5", "2;Jose;Medellin;200.25"]
        }
      }
    },
    {
      "nombre": "transformaciones: quitar duplicados",
      "job": "MCP_L5_Transformaciones",
      "pendiente": "el formato de la tabla UNIQUE_KEY del tUniqRow no esta resuelto: el codigo generado lee una columna suelta ('id cannot be resolved') en vez de la de la conexion de entrada",
      "nodos": [
        {
          "type": "tFileInputDelimited",
          "nombre": "lector",
          "parameters": {
            "FILENAME": { "value": "@TESTDATA@/l5_clientes.csv" },
            "FIELDSEPARATOR": { "value": ";" },
            "HEADER": { "value": "1" },
            "ENCODING": { "value": "UTF-8" }
          },
          "columnas": [
            { "name": "id", "type": "id_Integer" },
            { "name": "nombre", "type": "id_String" },
            { "name": "ciudad", "type": "id_String" },
            { "name": "monto", "type": "id_Double" }
          ]
        },
        {
          "type": "tUniqRow",
          "nombre": "unicos",
          "columnas": [
            { "name": "id", "type": "id_Integer" },
            { "name": "nombre", "type": "id_String" },
            { "name": "ciudad", "type": "id_String" },
            { "name": "monto", "type": "id_Double" }
          ],
          "tablas": {
            "UNIQUE_KEY": {
              "columns": ["SCHEMA_COLUMN", "KEY_ATTRIBUTE", "CASE_SENSITIVE"],
              "rows": [
                { "SCHEMA_COLUMN": "row1.id", "KEY_ATTRIBUTE": "true", "CASE_SENSITIVE": "false" },
                { "SCHEMA_COLUMN": "row1.nombre", "KEY_ATTRIBUTE": "false", "CASE_SENSITIVE": "false" },
                { "SCHEMA_COLUMN": "row1.ciudad", "KEY_ATTRIBUTE": "false", "CASE_SENSITIVE": "false" },
                { "SCHEMA_COLUMN": "row1.monto", "KEY_ATTRIBUTE": "false", "CASE_SENSITIVE": "false" }
              ]
            }
          }
        },
        { "type": "tLogRow", "nombre": "salida" }
      ],
      "conexiones": [
        { "origen": "lector", "destino": "unicos" },
        { "origen": "unicos", "destino": "salida" }
      ],
      "espera": {
        "lineas": [
          "1|Ana|Bogota|100.5",
          "2|Jose|Medellin|200.25",
          "3|Lucia|Cali|300.0"
        ]
      }
    }
  ]
}

