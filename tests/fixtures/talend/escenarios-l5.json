    {
      "nombre": "bases de datos: escribir en un Postgres y confirmar",
      "job": "MCP_L5_Escritura",
      "pendiente": "el tDBOutput genera el INSERT con los nombres de columna a null: el generador los saca de las columnas de la tabla de salida del nodo y el bridge solo consigue ponerlas en el SCHEMA_FLOW (los 'elementValue') y en el metadata. Con MAPPING=PostgreSQL el INSERT sale bien formado pero sin los nombres ('INSERT INTO tabla (null,null,null,null)'), y el Postgres lo rechaza con 'column \"null\" does not exist'. La lectura si funciona (el otro escenario)",
      "nodos": [
        {
          "type": "tFixedFlowInput",
          "nombre": "entrada",
          "columnas": [
            { "name": "id", "type": "id_Integer" },
            { "name": "nombre", "type": "id_String" },
            { "name": "ciudad", "type": "id_String" },
            { "name": "monto", "type": "id_Double" }
          ],
          "values": [
            ["1", "Ana", "Bogota", "100.5"],
            ["2", "Jose", "Medellin", "200.25"]
          ]
        },
        {
          "type": "tPostgresqlConnection",
          "nombre": "conexion",
          "parameters": {
            "HOST": { "value": "localhost" },
            "PORT": { "value": "5433" },
            "USER": { "value": "talend" },
            "PASS": { "value": "talend" },
            "DBNAME": { "value": "talend_test" }
          }
        },
        {
          "type": "tPostgresqlOutput",
          "nombre": "escribe",
          "parameters": {
            "USE_EXISTING_CONNECTION": { "value": "true" },
            "CONNECTION": { "value": "@uniqueName:conexion", "literal": false },
            "TABLE": { "value": "l5_salida" },
            "TABLE_ACTION": { "value": "DELETE" },
            "MAPPING": { "value": "PostgreSQL" },
            "SCHEMA_FLOW": {
              "value": [
                { "elementRef": "SCHEMA_COLUMN", "value": "id" },
                { "elementRef": "SCHEMA_COLUMN", "value": "nombre" },
                { "elementRef": "SCHEMA_COLUMN", "value": "ciudad" },
                { "elementRef": "SCHEMA_COLUMN", "value": "monto" }
              ],
              "field": "SCHEMA_TYPE"
            }
          },
          "columnas": [
            { "name": "id", "type": "id_Integer" },
            { "name": "nombre", "type": "id_String" },
            { "name": "ciudad", "type": "id_String" },
            { "name": "monto", "type": "id_Double" }
          ]
        },
        {
          "type": "tPostgresqlCommit",
          "nombre": "confirma",
          "parameters": {
            "USE_EXISTING_CONNECTION": { "value": "true" },
            "CONNECTION": { "value": "@uniqueName:conexion", "literal": false }
          }
        }
      ],
      "conexiones": [
        { "origen": "entrada", "destino": "escribe" }
      ],
      "espera": {
        "consulta": {
          "sql": "SELECT count(*)::int FROM l5_salida",
          "valor": 2
        }
      }
    },
