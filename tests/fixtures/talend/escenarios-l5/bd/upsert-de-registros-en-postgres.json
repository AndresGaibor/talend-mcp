{
  "nombre": "bases de datos: upsert de registros en Postgres",
  "job": "MCP_L5_PostgresUpsert",
  "prepara": [
    "DROP TABLE IF EXISTS l5_upsert",
    "CREATE TABLE l5_upsert (id integer PRIMARY KEY, nombre varchar(80), estado varchar(20))",
    "INSERT INTO l5_upsert VALUES (1, 'Nombre anterior', 'ACTIVO')"
  ],
  "nodos": [
    {
      "type": "tFixedFlowInput",
      "nombre": "entrada",
