          "value": "talend_test"
        },
        "AUTO_COMMIT": {
          "value": "true"
        }
      }
    },
    {
      "type": "tPostgresqlOutput",
      "nombre": "upsert",
      "parameters": {
        "USE_EXISTING_CONNECTION": {
          "value": "true"
        },
        "CONNECTION": {
          "value": "@uniqueName:conexion",
          "literal": false
        },
        "TABLE": {
          "value": "l5_upsert"
        },
        "TABLE_ACTION": {
          "value": "NONE"
        },
        "DATA_ACTION": {
          "value": "INSERT_OR_UPDATE"
        },
        "USE_FIELD_OPTIONS": {
          "value": "true"
        },
        "MAPPING": {
          "value": "postgres_id"
        },
        "END_OF_FLOW": {
          "value": "false"
        }
      },
      "tablas": {
        "FIELD_OPTIONS": {
          "columns": [
            "SCHEMA_COLUMN",
            "UPDATE_KEY",
            "DELETE_KEY",
            "UPDATABLE",
            "INSERTABLE"
          ],
          "rows": [
            {
              "SCHEMA_COLUMN": "id",
              "UPDATE_KEY": "true",
              "DELETE_KEY": "false",
              "UPDATABLE": "false",
              "INSERTABLE": "true"
            },
            {
              "SCHEMA_COLUMN": "nombre",
              "UPDATE_KEY": "false",
              "DELETE_KEY": "false",
              "UPDATABLE": "true",
              "INSERTABLE": "true"
            },
            {
              "SCHEMA_COLUMN": "estado",
              "UPDATE_KEY": "false",
