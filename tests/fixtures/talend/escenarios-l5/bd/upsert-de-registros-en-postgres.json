        {
          "name": "id",
          "type": "id_Integer",
          "key": true
        },
        {
          "name": "nombre",
          "type": "id_String"
        },
        {
          "name": "estado",
          "type": "id_String"
        }
      ],
      "values": [
        [
          "1",
          "Nombre actualizado",
          "INACTIVO"
        ],
        [
          "2",
          "Nuevo cliente",
          "ACTIVO"
        ]
      ]
    },
    {
      "type": "tPostgresqlConnection",
      "nombre": "conexion",
      "parameters": {
