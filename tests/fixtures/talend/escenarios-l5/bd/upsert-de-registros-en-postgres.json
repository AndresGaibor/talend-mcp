    }
  ],
  "espera": {
    "consulta": {
      "sql": "SELECT count(*)::text || ':' || max(CASE WHEN id = 1 THEN nombre END) || ':' || max(CASE WHEN id = 2 THEN nombre END) FROM l5_upsert",
