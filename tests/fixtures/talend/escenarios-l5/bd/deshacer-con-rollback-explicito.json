{
  "nombre": "bases de datos: deshacer con rollback explicito",
  "job": "MCP_L5_Rollback",
  "prepara": [
    "DROP TABLE IF EXISTS l5_rollback",
    "CREATE TABLE l5_rollback (id integer, nombre varchar(50))",
    "INSERT INTO l5_rollback VALUES (1, 'Ana'), (2, 'Jose')"
  ],
  "nodos": [
    {
      "type": "tFixedFlowInput",
      "nombre": "entrada",
      "columnas": [
        {
          "name": "id",
          "type": "id_Integer"
        },
        {
          "name": "nombre",
          "type": "id_String"
        }
      ],
      "values": [
        [
          "2",
          "Jose Cambiado"
        ]
      ]
    },
    {
      "type": "tPostgresqlConnection",
      "nombre": "conexion",
      "parameters": {
        "HOST": {
          "value": "localhost"
        },
        "PORT": {
          "value": "5433"
        },
        "USER": {
          "value": "talend"
        },
        "PASS": {
          "value": "talend"
        },
        "DBNAME": {
          "value": "talend_test"
        },
        "AUTO_COMMIT": {
          "value": "false"
        }
      }
    },
    {
      "type": "tPostgresqlOutput",
      "nombre": "actualiza",
      "parameters": {
        "USE_EXISTING_CONNECTION": {
          "value": "true"
        },
        "CONNECTION": {
          "value": "@uniqueName:conexion",
          "literal": false
        },
        "TABLE": {
          "value": "l5_rollback"
        },
        "TABLE_ACTION": {
          "value": "NONE"
        },
        "USE_FIELD_OPTIONS": {
          "value": "true"
        },
        "DATA_ACTION": {
          "value": "UPDATE"
        },
        "MAPPING": {
          "value": "postgres_id"
        },
        "END_OF_FLOW": {
          "value": "false"
        }
      },
      "tablas": {
        "FIELD_OPTIONS": {
          "columns": [
            "SCHEMA_COLUMN",
            "UPDATE_KEY",
            "DELETE_KEY",
            "UPDATABLE",
            "INSERTABLE"
          ],
          "rows": [
            {
              "SCHEMA_COLUMN": "id",
              "UPDATE_KEY": "true",
              "DELETE_KEY": "false",
              "UPDATABLE": "false",
              "INSERTABLE": "false"
            },
            {
              "SCHEMA_COLUMN": "nombre",
              "UPDATE_KEY": "false",
              "DELETE_KEY": "false",
              "UPDATABLE": "true",
              "INSERTABLE": "true"
            }
          ]
        }
      },
      "columnas": [
        {
          "name": "id",
          "type": "id_Integer",
          "sourceType": "INT4"
        },
        {
          "name": "nombre",
          "type": "id_String",
          "sourceType": "VARCHAR"
        }
      ],
      "schemaDespuesDeConectar": true
    },
    {
      "type": "tPostgresqlRollback",
      "nombre": "deshace",
      "parameters": {
        "CONNECTION": {
          "value": "@uniqueName:conexion",
          "literal": false
        },
        "CLOSE": {
          "value": "false"
        }
      }
    }
  ],
  "conexiones": [
    {
      "origen": "entrada",
      "destino": "actualiza"
    },
    {
      "origen": "entrada",
      "destino": "deshace",
      "tipo": "SUBJOB_OK"
    }
  ],
  "espera": {
    "consulta": {
      "sql": "SELECT nombre FROM l5_rollback WHERE id = 2",
      "valor": "Jose"
    }
  }
}
