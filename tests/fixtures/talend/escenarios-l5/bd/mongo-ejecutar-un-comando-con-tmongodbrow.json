{
  "nombre": "bases de datos: insertar con un comando en MongoDB con tMongoDBRow",
  "job": "MCP_L5_MongoRow",
  "nodos": [
    {
      "type": "tMongoDBConnection",
      "nombre": "conexion",
      "parameters": {
        "HOST": {
          "value": "localhost"
        },
        "PORT": {
          "value": "27018"
        },
        "DATABASE": {
          "value": "talend_test"
        },
        "REQUIRED_AUTHENTICATION": {
          "value": "true"
        },
        "AUTHENTICATION_MECHANISM": {
          "value": "SCRAMSHA256_MEC"
        },
