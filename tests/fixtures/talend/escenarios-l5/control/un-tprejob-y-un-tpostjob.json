{
  "nombre": "control de flujo: un tPrejob y un tPostjob",
  "job": "MCP_L5_PrePost",
  "nodos": [
    {
      "type": "tPrejob",
      "nombre": "pre"
    },
    {
      "type": "tFixedFlowInput",
      "nombre": "preFila",
      "columnas": [
        {
          "name": "paso",
          "type": "id_String"
        }
      ],
      "values": [
        [
          "pre"
        ]
      ]
    },
    {
      "type": "tFileOutputDelimited",
      "nombre": "preEscribe",
      "parameters": {
        "FILENAME": {
          "value": "@TESTDATA@/l5_prepost.txt"
        },
        "FIELDSEPARATOR": {
          "value": ";"
        },
        "APPEND": {
          "value": "false"
        },
        "FILE_EXIST_EXCEPTION": {
          "value": "false"
        }
      }
    },
    {
      "type": "tFixedFlowInput",
      "nombre": "principalFila",
      "columnas": [
        {
          "name": "paso",
          "type": "id_String"
        }
      ],
      "values": [
        [
          "principal"
        ]
      ]
    },
    {
      "type": "tFileOutputDelimited",
      "nombre": "principalEscribe",
      "parameters": {
        "FILENAME": {
          "value": "@TESTDATA@/l5_prepost.txt"
        },
        "FIELDSEPARATOR": {
          "value": ";"
        },
        "APPEND": {
          "value": "true"
        }
      }
    },
    {
      "type": "tPostjob",
      "nombre": "post"
    },
    {
      "type": "tFixedFlowInput",
      "nombre": "postFila",
      "columnas": [
        {
          "name": "paso",
          "type": "id_String"
        }
      ],
      "values": [
        [
          "post"
        ]
      ]
    },
    {
      "type": "tFileOutputDelimited",
      "nombre": "postEscribe",
      "parameters": {
        "FILENAME": {
          "value": "@TESTDATA@/l5_prepost.txt"
        },
        "FIELDSEPARATOR": {
          "value": ";"
        },
        "APPEND": {
          "value": "true"
        }
      }
    }
  ],
  "conexiones": [
    {
      "origen": "preFila",
      "destino": "preEscribe"
    },
    {
      "origen": "principalFila",
      "destino": "principalEscribe"
    },
    {
      "origen": "postFila",
      "destino": "postEscribe"
    },
    {
      "origen": "pre",
      "destino": "preFila",
      "tipo": "COMPONENT_OK"
    },
    {
      "origen": "post",
      "destino": "postFila",
      "tipo": "COMPONENT_OK"
    }
  ],
  "espera": {
    "fichero": {
      "ruta": "@TESTDATA@/l5_prepost.txt",
      "lineas": [
        "pre",
        "principal",
        "post"
      ]
    }
  }
}
