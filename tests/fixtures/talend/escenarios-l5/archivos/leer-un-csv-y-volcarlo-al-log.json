{
  "nombre": "archivos: leer un CSV y volcarlo al log",
  "job": "MCP_L5_Leer",
  "nodos": [
    {
      "type": "tFileInputDelimited",
      "nombre": "lector",
      "parameters": {
        "FILENAME": {
          "value": "@TESTDATA@/l5_clientes.csv"
        },
        "FIELDSEPARATOR": {
          "value": ";"
        },
        "HEADER": {
          "value": "1"
        },
        "ENCODING": {
          "value": "UTF-8"
        }
      },
      "columnas": [
        {
          "name": "id",
          "type": "id_Integer"
        },
        {
          "name": "nombre",
          "type": "id_String"
        },
        {
          "name": "ciudad",
          "type": "id_String"
        },
        {
          "name": "monto",
          "type": "id_Double"
        }
      ]
    },
    {
      "type": "tLogRow",
      "nombre": "salida"
    }
  ],
  "conexiones": [
    {
      "origen": "lector",
      "destino": "salida"
    }
  ],
  "espera": {
    "lineas": [
      "1|Ana|Bogota|100.5",
      "2|Jose|Medellin|200.25",
      "3|Lucia|Cali|300.0",
      "1|Ana|Bogota|100.5"
    ]
  }
}
