  "job": "MCP_L5_FileCopy",
  "nodos": [
    {
      "type": "tFileCopy",
      "nombre": "copia",
      "parameters": {
        "FILENAME": {
          "value": "@TESTDATA@/ancho_fijo.txt"
        },
        "ENABLE_COPY_DIRECTORY": {
