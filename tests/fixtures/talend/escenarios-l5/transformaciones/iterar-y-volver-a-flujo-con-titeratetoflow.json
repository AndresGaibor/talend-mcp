{
  "nombre": "transformaciones: iterar y volver a flujo con tIterateToFlow",
  "job": "MCP_L5_IterarFlujo",
  "nodos": [
    {
      "type": "tFixedFlowInput",
      "nombre": "entrada",
      "columnas": [
        { "name": "id", "type": "id_Integer" },
        { "name": "nombre", "type": "id_String" }
      ],
      "values": [
        ["1", "Ana"],
        ["2", "Jose"]
      ]
    },
    {
      "type": "tFlowToIterate",
      "nombre": "itera"
    },
    {
      "type": "tIterateToFlow",
      "nombre": "vuelve",
      "parameters": {
        "MAPPING": {
          "value": [
            { "SCHEMA_COLUMN": "id", "VALUE": "row1.id" },
            { "SCHEMA_COLUMN": "nombre", "VALUE": "row1.nombre" }
          ]
        }
      },
      "columnas": [
        { "name": "id", "type": "id_Integer" },
        { "name": "nombre", "type": "id_String" }
      ]
    },
    {
      "type": "tLogRow",
      "nombre": "salida"
    }
  ],
  "conexiones": [
    { "origen": "entrada", "destino": "itera" },
    { "origen": "itera", "destino": "vuelve", "tipo": "ITERATE" },
    { "origen": "vuelve", "destino": "salida" }
  ],
  "espera": {
    "contiene": ["1|Ana", "2|Jose"]
  }
}
