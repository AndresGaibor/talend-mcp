      "tablas": {
        "configuration.buckets": {
          "columns": [
            "configuration.buckets[].bucketName",
            "configuration.buckets[].keyPrefix"
          ],
          "rows": [
            {
              "configuration.buckets[].bucketName": "talend-l5-listado",
              "configuration.buckets[].keyPrefix": "l5/listado/"
            }
          ]
        }
      },
      "columnas": [
        {
          "name": "key",
          "type": "id_String"
        }
      ]
    },
    {
      "type": "tJava",
      "nombre": "imprime",
      "parameters": {
        "CODE": {
          "value": "String clave = (String) globalMap.get(\"@uniqueName:lista\" + \"_CURRENT_KEY\");\nif (!clave.startsWith(\"l5/listado/\")) { throw new RuntimeException(\"fuera del prefijo: \" + clave); }\nSystem.out.println(\"clave: \" + clave);"
        }
      }
    }
  ],
  "conexiones": [
    {
      "origen": "crea",
      "destino": "sube1",
      "tipo": "SUBJOB_OK"
    },
    {
