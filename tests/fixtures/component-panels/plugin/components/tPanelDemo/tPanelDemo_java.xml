<COMPONENT>
  <HEADER PLATEFORM="ALL" VERSION="0.1" STARTABLE="true"/>
  <FAMILIES>
    <FAMILY>File/Output</FAMILY>
  </FAMILIES>
  <CONNECTORS>
    <CONNECTOR CTYPE="FLOW" MAX_INPUT="1" MAX_OUTPUT="1"/>
  </CONNECTORS>
  <PARAMETERS>
    <PARAMETER NAME="SEPARATOR_DECO" FIELD="LABEL" NUM_ROW="5">
      <DEFAULT>Texto decorativo sin etiqueta</DEFAULT>
    </PARAMETER>
    <PARAMETER NAME="FILENAME" FIELD="FILE" NUM_ROW="20" REQUIRED="true">
      <DEFAULT>"__COMP_DEFAULT_FILE_DIR__/out.csv"</DEFAULT>
    </PARAMETER>
    <PARAMETER NAME="SEPARATOR" FIELD="TEXT" NUM_ROW="10" REQUIRED="true">
      <DEFAULT>";"</DEFAULT>
    </PARAMETER>
    <PARAMETER NAME="CSVROWSEPARATOR" FIELD="OPENED_LIST" NUM_ROW="30">
      <ITEMS DEFAULT="LF">
        <ITEM NAME="LF" VALUE="&quot;\n&quot;"/>
        <ITEM NAME="CR" VALUE="&quot;\r&quot;"/>
      </ITEMS>
    </PARAMETER>
    <PARAMETER NAME="MAPEO" FIELD="TABLE" NUM_ROW="40" NB_LINES="3">
      <ITEMS BASED_ON_SCHEMA="true">
        <ITEM NAME="COL" FIELD="TEXT"/>
        <ITEM NAME="FUNC" FIELD="CLOSED_LIST">
          <ITEMS DEFAULT="AVG">
            <ITEM NAME="AVG" VALUE="avg"/>
            <ITEM NAME="SUM" VALUE="sum"/>
          </ITEMS>
        </ITEM>
      </ITEMS>
    </PARAMETER>
    <PARAMETER NAME="SIN_FILA" FIELD="TEXT" GROUP="AUTHENTICATION">
      <DEFAULT>""</DEFAULT>
    </PARAMETER>
  </PARAMETERS>
  <ADVANCED_PARAMETERS>
    <PARAMETER NAME="AVANZADO" FIELD="CHECK" NUM_ROW="2">
      <DEFAULT>false</DEFAULT>
    </PARAMETER>
  </ADVANCED_PARAMETERS>
</COMPONENT>
