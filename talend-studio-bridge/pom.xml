<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.andres.talend</groupId>
  <artifactId>talend-studio-bridge-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <modules>
    <module>com.andres.talend.bridge</module>
    <module>com.andres.talend.bridge.feature</module>
    <module>com.andres.talend.bridge.repository</module>
  </modules>

  <properties>
    <tycho.version>4.0.13</tycho.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>17</maven.compiler.release>
  </properties>

  <build>
    <plugins>
      <plugin>
        <groupId>org.eclipse.tycho</groupId>
        <artifactId>tycho-maven-plugin</artifactId>
        <version>${tycho.version}</version>
        <extensions>true</extensions>
      </plugin>
    </plugins>
  </build>

  <!--
    Target platform del plugin.

    Se compila contra un release estable de Eclipse (no contra la instalacion de
    Talend Studio) y el MANIFEST no fija versiones, asi que el bundle resultante
    es instalable en cualquier Talend Studio 8.x.

    Gson llega desde el repositorio de Orbit: el bundle oficial de la
    instalacion de Talend aporta los mismos paquetes en tiempo de ejecucion.
  -->
  <repositories>
    <repository>
      <id>eclipse-2024-06</id>
      <layout>p2</layout>
      <url>https://download.eclipse.org/releases/2024-06</url>
    </repository>
    <repository>
      <id>orbit-aggregation</id>
      <layout>p2</layout>
      <url>https://download.eclipse.org/tools/orbit/simrel/orbit-aggregation/release/latest</url>
    </repository>
  </repositories>

  <pluginRepositories>
    <pluginRepository>
      <id>eclipse-2024-06</id>
      <layout>p2</layout>
      <url>https://download.eclipse.org/releases/2024-06</url>
    </pluginRepository>
    <pluginRepository>
      <id>orbit-aggregation</id>
      <layout>p2</layout>
      <url>https://download.eclipse.org/tools/orbit/simrel/orbit-aggregation/release/latest</url>
    </pluginRepository>
  </pluginRepositories>
</project>
